model IncomeEntry {
  id            Int                 @id @default(autoincrement())
  schoolId      Int
  category      IncomeEntryCategory @default(OTHER_INCOME)
  sourceLabel   String
  title         String
  amount        Decimal             @db.Decimal(10, 2)
  incomeDate    DateTime
  billingMonth  String
  paymentMethod PaymentMethod       @default(CASH)
  receiptNo     String?
  referenceNo   String?
  notes         String?
  recordedById  Int

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recordedBy User   @relation("IncomeEntryRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, receiptNo])
  @@index([schoolId, billingMonth])
  @@index([schoolId, incomeDate])
  @@map("income_entries")
}
