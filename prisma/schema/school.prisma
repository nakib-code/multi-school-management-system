model School {
  id Int @id @default(autoincrement())

  name    String
  code    String  @unique
  email   String?
  phone   String?
  address String?
  logo    String?

  status SchoolStatus @default(PENDING)

  adminName          String?
  adminEmail         String?
  adminPhone         String?
  adminPasswordHash  String?
  adminEmailVerified Boolean @default(false)
  selectedPackageId  Int?

  selectedPackage Package? @relation("SchoolSelectedPackage", fields: [selectedPackageId], references: [id], onDelete: SetNull)

  subscriptions        SchoolSubscription[]
  subscriptionPayments SubscriptionPayment[]

  guardians       Guardian[]
  teachers        Teacher[]
  managers        Manager[]
  classes         SchoolClass[]
  sections        Section[]
  subjects        Subject[]
  enrollments     Enrollment[]
  attendances     Attendance[]
  exams           Exam[]
  results         Result[]
  studentFees     StudentFee[]
  studentPayments StudentPayment[]
  teacherSalaries TeacherSalary[]
  salaryPayments  SalaryPayment[]
  admissions      Admission[]
  auditLogs       AuditLog[]
  users           User[]

  customPackageRequests CustomPackageRequest[]

  admissionPayments  AdmissionPayment[]
  schoolSetting      SchoolSetting?
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    // ---- নতুন যোগ হচ্ছে Landing Page-এর জন্য ----
  subdomain               String?  @unique
  customDomain            String?  @unique
  domainVerified          Boolean  @default(false)
  domainVerificationToken String?

  // Branding
  tagline     String?   // "Excellence in Islamic Education"
  description String?   @db.Text
  primaryColor String?  @default("#0F766E")  // Islamic green
  secondaryColor String? @default("#F59E0B")

  // Contact info (footer-এর জন্য)
  contactEmail   String?
  contactPhone   String?
  contactAddress String?  @db.Text
  facebookUrl    String?
  youtubeUrl     String?
  mapEmbedUrl    String?  @db.Text

  // Landing page content relations
  pageContents   SchoolPageContent[]
  notices        SchoolNotice[]
  galleryImages  SchoolGalleryImage[]
  contactMessages SchoolContactMessage[]

  @@index([subdomain])
  @@index([customDomain])

  @@index([name])
  @@index([selectedPackageId])
  @@map("schools")
}
