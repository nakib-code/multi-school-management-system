model School {
  id Int @id @default(autoincrement())

  name    String
  code    String  @unique
  email   String?
  phone   String?
  address String?
  logo    String?

  status SchoolStatus @default(PENDING)

  adminName          String?
  adminEmail         String?
  adminPhone         String?
  adminPasswordHash  String?
  adminEmailVerified Boolean @default(false)

  subscriptions SchoolSubscription[]

  guardians             Guardian[]
  teachers              Teacher[]
  managers              Manager[]
  classes               SchoolClass[]
  sections              Section[]
  subjects              Subject[]
  enrollments           Enrollment[]
  attendances           Attendance[]
  exams                 Exam[]
  results               Result[]
  studentFees           StudentFee[]
  studentPayments       StudentPayment[]
  teacherSalaries       TeacherSalary[]
  salaryPayments        SalaryPayment[]
  admissions            Admission[]
  auditLogs             AuditLog[]
  users                 User[]
  customPackageRequests CustomPackageRequest[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  admissionPayments  AdmissionPayment[]
  schoolSetting      SchoolSetting?
  teacherAssignments TeacherAssignment[]

  @@index([name])
  @@map("schools")
}
