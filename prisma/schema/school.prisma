model School {
  id Int @id @default(autoincrement())

  name    String
  code    String  @unique
  email   String?
  phone   String?
  address String?
  logo    String?

  status SchoolStatus @default(PENDING)

  adminName          String?
  adminEmail         String?
  adminPhone         String?
  adminPasswordHash  String?
  adminEmailVerified Boolean @default(false)

  rejectionReason String?

  guardians Guardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teachers           Teacher[]
  setting SchoolSetting?
  admissionPayments  AdmissionPayment[]
  managers           Manager[]
  classes            SchoolClass[]
  sections           Section[]
  subjects           Subject[]
  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]
  attendances        Attendance[]
  exams              Exam[]
  results            Result[]
  studentFees        StudentFee[]
  studentPayments    StudentPayment[]
  teacherSalaries    TeacherSalary[]
  salaryPayments     SalaryPayment[]
  admissions         Admission[]
  auditLogs          AuditLog[]
  users              User[]

  @@index([name])
  @@map("schools")
}
