model Admission {
  id       Int @id @default(autoincrement())

  schoolId Int
  classId  Int
  sectionId Int?

  school  School      @relation(fields: [schoolId], references: [id])
  class   SchoolClass @relation(fields: [classId], references: [id])
  section Section?    @relation(fields: [sectionId], references: [id])

  applicationNo String @unique

  // Student Information
  studentName     String
  nameBangla      String?
  studentEmail    String?
  passwordHash    String?
  dateOfBirth     DateTime?
  gender          String?
  bloodGroup      String?
  birthRegNo      String?
  residentialType ResidentialType @default(NON_RESIDENTIAL)
  previousSchool  String?
  previousClass   String?

  // Guardian & Parent Information
  guardianName         String?
  guardianEmail        String?
  guardianPhone        String?
  guardianRelationship String?
  guardianNid          String?
  guardianOccupation   String?
  fatherName           String?
  motherName           String?

  // Address
  address          String?
  presentAddress   String?
  permanentAddress String?

  // Application Information
  academicYear  String
  shift         String?
  group         String?
  academicGroup AcademicGroup?
  quranWing     HefzWing?

  // Documents
  studentPhotoUrl        String?
  birthCertificateUrl    String?
  previousCertificateUrl String?
  guardianNidUrl         String?
  previousTcUrl          String?
  marksheetUrl           String?

  // Admission Status
  status               AdmissionStatus @default(PENDING)
  studentEmailVerified Boolean         @default(false)

  // Review
  reviewedAt      DateTime?
  reviewedBy      Int?
  rejectionReason String?

  reviewer User? @relation("AdmissionReviewer",fields: [reviewedBy],references: [id])

  payment AdmissionPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([status])
  @@index([studentEmail])
  @@index([guardianPhone])
  @@index([academicYear])

  @@map("admissions")
}