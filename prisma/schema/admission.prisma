model Admission {
  id Int @id @default(autoincrement())

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  applicationNo String @unique

  studentName  String
  studentEmail String
  passwordHash String

  dateOfBirth DateTime?
  gender      String?

  guardianName  String?
  guardianPhone String?

  previousSchool String?
  address        String?

  status               AdmissionStatus @default(PENDING)
  studentEmailVerified Boolean         @default(false)
  reviewedAt           DateTime?
  reviewedBy           Int?
  rejectionReason      String?

  reviewer User? @relation("AdmissionReviewer", fields: [reviewedBy], references: [id])

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  payment   AdmissionPayment?

  @@index([schoolId])
  @@index([status])
  @@index([studentEmail])
  @@index([guardianPhone])
  @@map("admissions")
}
