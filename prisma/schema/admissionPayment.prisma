model AdmissionPayment {
  id          Int @id @default(autoincrement())
  admissionId Int @unique
  schoolId    Int

  amount        Decimal                @db.Decimal(10, 2)
  paymentMethod AdmissionPaymentMethod
  status        AdmissionPaymentStatus @default(PENDING)

  transactionId String? @unique
  senderNumber  String?

  paidAt     DateTime?
  receivedBy Int?
  remarks    String?

  admission Admission @relation(fields: [admissionId], references: [id])

  school School @relation(fields: [schoolId], references: [id])

  receivedByUser User?       @relation(fields: [receivedBy], references: [id])
  studentFee     StudentFee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([status])
  @@index([paymentMethod])
  @@map("admission_payments")
}
