model SchoolSetting {
  id Int @id @default(autoincrement())

  schoolId Int @unique

  admissionFee Decimal @db.Decimal(10, 2)

  bkashNumber  String?
  nagadNumber  String?
  rocketNumber String?

  school School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("school_settings")
}
