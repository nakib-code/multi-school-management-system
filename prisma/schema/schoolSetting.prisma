model SchoolSetting {
  id Int @id @default(autoincrement())

  schoolId Int @unique

  admissionFee Decimal @default(0) @db.Decimal(10, 2)

  // Per-School Feature Flags (Controlled by Super Admin)
  hasGeneralSection  Boolean @default(true)
  hasHefzSection     Boolean @default(true)
  hasPublicWebsite   Boolean @default(false)
  hasOnlineAdmission Boolean @default(false)
  hasTeacherPayroll  Boolean @default(false)
  smsEnabled         Boolean @default(false)

  // School-Level Manual Mobile Banking Settings (Editable by School Admin / Manager)
  bkashNumber           String?
  bkashType             MobileAccountType @default(PERSONAL)
  nagadNumber           String?
  nagadType             MobileAccountType @default(PERSONAL)
  rocketNumber          String?
  rocketType            MobileAccountType @default(PERSONAL)
  feePaymentInstruction String?           @db.Text

  // Attendance Settings (0=Sunday ... 5=Friday, 6=Saturday; default Friday)
  weeklyOffDays Int[] @default([5])

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("school_settings")
}
