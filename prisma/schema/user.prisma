model User {
  id                 Int        @id @default(autoincrement())
  name               String
  email              String     @unique
  passwordHash       String
  phone              String?
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  passwordChangedAt  DateTime?
  avatarUrl          String?

  // Multi-school relation
  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id])

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  guardian Guardian?
  student  Student?
  teacher  Teacher?
  manager  Manager?

  markedAttendances            Attendance[]
  attendanceHistoriesChanged   AttendanceHistory[]   @relation("AttendanceHistoryActor")
  leaveRequestsCreated         LeaveRequest[]        @relation("LeaveRequestRequester")
  leaveRequestsReviewed        LeaveRequest[]        @relation("LeaveRequestReviewer")
  monthlyReportsPublished      MonthlyReport[]       @relation("MonthlyReportPublisher")
  receivedAdmissionPayments    AdmissionPayment[]
  verifiedStudentPayments      StudentPayment[]      @relation("StudentPaymentVerifier")
  verifiedSubscriptionPayments SubscriptionPayment[] @relation("SubscriptionPaymentVerifier")
  paidSalaryPayments           SalaryPayment[]
  admissionsReviewed           Admission[]           @relation("AdmissionReviewer")
  auditLogs                    AuditLog[]
  passwordResetTokens          PasswordResetToken[]
  notifications                Notification[]
  platformAuditLogs            PlatformAuditLog[]    @relation("PlatformAuditActor")
  uploadedFiles                UploadedFile[]
  classDiariesCreated          ClassDiary[]          @relation("ClassDiaryAuthor")
  customExpenseSheetsCreated   CustomExpenseSheet[]  @relation("CustomExpenseSheetCreator")
  customExpenseEntriesRecorded CustomExpenseEntry[]  @relation("CustomExpenseEntryRecorder")
  incomeEntriesRecorded        IncomeEntry[]         @relation("IncomeEntryRecorder")
  waivedStudentFees            StudentFee[]          @relation("StudentFeeWaiver")

  @@index([role])
  @@index([status])
  @@index([schoolId])
  @@map("users")
}
