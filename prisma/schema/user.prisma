model User {
  id                 Int        @id @default(autoincrement())
  name               String
  email              String     @unique
  passwordHash       String
  phone              String?
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)

  // Multi-school relation
  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id])

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  guardian Guardian?
  student  Student?
  teacher  Teacher?
  manager  Manager?

  markedAttendances         Attendance[]
  receivedAdmissionPayments AdmissionPayment[]
  receivedStudentPayments   StudentPayment[]
  paidSalaryPayments        SalaryPayment[]
  admissionsReviewed        Admission[]        @relation("AdmissionReviewer")
  auditLogs                 AuditLog[]

  @@index([role])
  @@index([status])
  @@index([schoolId])
  @@map("users")
}
