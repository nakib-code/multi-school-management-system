model SubscriptionPayment {
  id Int @id @default(autoincrement())

  subscriptionId Int
  schoolId       Int

  paymentMethod  SubscriptionPaymentMethod
  senderNumber   String
  receiverNumber String?
  trxId          String
  paidAmount     Decimal                   @db.Decimal(10, 2)
  currency       String                    @default("BDT")
  status         SubscriptionPaymentStatus @default(PENDING)

  paidAt          DateTime  @default(now())
  verifiedById    Int?
  verifiedAt      DateTime?
  rejectionReason String?
  remarks         String?

  subscription SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  school       School             @relation(fields: [schoolId], references: [id])
  verifiedBy   User?              @relation("SubscriptionPaymentVerifier", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([schoolId])
  @@index([trxId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@map("subscription_payments")
}
