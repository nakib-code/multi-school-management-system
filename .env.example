# ============================================
# Server & Environment
# ============================================
NODE_ENV=development
PORT=5001
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# ============================================
# PostgreSQL Database (Prisma)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_hub?schema=public"

# ============================================
# Redis Cache & Verification Codes
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Authentication & JWT
# ============================================
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"

# ============================================
# Google OAuth (Optional)
# ============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5001/api/v1/auth/google/callback"

# ============================================
# SMTP / Email Service (Nodemailer)
# ============================================
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_SENDER="School Hub <noreply@schoolhub.com>"

# ============================================
# Platform Manual Mobile Banking Accounts
# (bKash / Nagad / Rocket for School Subscriptions)
# ============================================
PLATFORM_BKASH_NUMBER="01700000000"
PLATFORM_NAGAD_NUMBER="01700000000"
PLATFORM_ROCKET_NUMBER="017000000000"
