# ============================================
# Server & Environment
# ============================================
# Use "production" on Vercel Staging/Production so cookies use Secure + SameSite=None
NODE_ENV=development
PORT=5001
BACKEND_URL="http://localhost:5001"
# Must match exact Frontend origin (no trailing slash) for CORS + credentials
FRONTEND_URL="http://localhost:3000"

# ============================================
# PostgreSQL Database (Neon / Prisma)
# ============================================
# Runtime URL (use Neon pooler endpoint in staging/production)
# For `prisma migrate deploy`, temporarily use the Neon direct (non-pooler) URL
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ============================================
# Redis Cache, OTPs & Rate Limiting
# ============================================
# Provide REDIS_URL OR the individual REDIS_* fields below
REDIS_URL=""
REDIS_USER="default"
REDIS_PASSWORD=""
REDIS_HOST="localhost"
REDIS_PORT=6379

# ============================================
# Authentication & JWT (REQUIRED)
# ============================================
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"

# ============================================
# SMTP / Email Service (Nodemailer - Gmail SMTP)
# ============================================
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-gmail-app-password"
EMAIL_SENDER="MadrasaOS <noreply@example.com>"

# ============================================
# Platform Manual Mobile Banking Accounts (REQUIRED for Subscriptions)
# ============================================
PLATFORM_BKASH_NUMBER="01700000000"
PLATFORM_NAGAD_NUMBER="01700000000"
PLATFORM_ROCKET_NUMBER="017000000000"

# ============================================
# Cloudinary Cloud File Storage (REQUIRED for Image/Document Uploads)
# ============================================
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ============================================
# Google OAuth (Optional)
# ============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5001/api/v1/auth/google/callback"
